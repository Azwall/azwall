{
  "name": "@azwall/pxe-v6",
  "private": true,
  "license": "Apache-2.0",
  "description": "PXE host for Aztec 6.0.0 (testnet v6)",
  "type": "module",
  "scripts": {
    "sync": "node ../scripts/sync-host.mjs",
    "build": "node ../scripts/sync-host.mjs && vite build && vite build -c vite.content-script.config.ts",
    "test": "node ../scripts/sync-host.mjs && vitest run",
    "typecheck": "node ../scripts/sync-host.mjs && tsc -p ."
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "6.0.0",
    "@aztec-foundation/noir-acvm_js": "6.0.0",
    "@aztec-foundation/noir-noirc_abi": "6.0.0",
    "@aztec-labs/accounts": "6.0.0",
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/bb-prover": "6.0.0",
    "@aztec-labs/constants": "6.0.0",
    "@aztec-labs/entrypoints": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/kv-store": "6.0.0",
    "@aztec-labs/noir-contracts.js": "6.0.0",
    "@aztec-labs/noir-protocol-circuits-types": "6.0.0",
    "@aztec-labs/protocol-contracts": "6.0.0",
    "@aztec-labs/pxe": "6.0.0",
    "@aztec-labs/simulator": "6.0.0",
    "@aztec-labs/sqlite3mc-wasm": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallet-sdk": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "@azwall/pxe-shared": "workspace:*",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.5"
  },
  "azwallHost": {
    "imports": {
      "@aztec/bb.js": "@aztec-foundation/bb.js",
      "@aztec/noir-acvm_js": "@aztec-foundation/noir-acvm_js",
      "@aztec/noir-noirc_abi": "@aztec-foundation/noir-noirc_abi",
      "@aztec/noir-noir_js": "@aztec-foundation/noir-noir_js",
      "@aztec/": "@aztec-labs/"
    }
  }
}
