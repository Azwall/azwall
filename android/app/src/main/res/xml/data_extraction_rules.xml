<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone in a cloud backup or a device-to-device transfer: the wallet's files hold addresses,
  amounts and history in clear (the privacy Aztec gives would end up in a backup), and the vault only opens with
  this phone's Keystore key anyway. Restoring a wallet means importing its key.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
