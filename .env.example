# Copy to .env (gitignored) and fill in. Resolved at build time by `azwall-config` (rust/azwall-core)
# into assets/azwall-config.json, which both apps bundle. Anything here ends up inside the APK/IPA:
# use keys restricted by quota or origin, never an unrestricted secret.

# Aztec node JSON-RPC endpoint per network. The key is AZWALL_RPC_ + the network id from
# networks.json, upper-cased, with '-' replaced by '_'. Empty = the network's `defaultRpc`.
# Example with a dRPC key:  AZWALL_RPC_TESTNET_V6=https://lb.drpc.org/aztec-testnet/<YOUR_KEY>
AZWALL_RPC_TESTNET_V6=
AZWALL_RPC_TESTNET_V5=

# Max calls per JSON-RPC batch. The free public dRPC endpoint rejects batches > 3. Empty = 3.
AZWALL_RPC_MAX_BATCH=
